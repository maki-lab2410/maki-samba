{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "maki-samba/portal",
    "type": "project",
    "description": "Portal Samba Automation & Web File Manager - Lab RMIK",
    "keywords": ["laravel", "samba", "filemanager"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

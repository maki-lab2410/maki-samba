APP_NAME="Maki Samba"
APP_TITLE="Maki Samba"
APP_INSTITUTION="Laboratorium Rekam Medis & Informasi Kesehatan (RMIK)"
APP_INSTITUTION_SHORT="Lab RMIK"
APP_DESCRIPTION="Portal File Manager & Otomatisasi Samba"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=info

# Driver Session: 'file' atau 'cookie' (Murni tanpa database)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Filesystem Driver
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# KONFIGURASI KHUSUS MAKI SAMBA & LINUX
# ------------------------------------------------------------------------------
# Root folder penyimpanan mahasiswa di AlmaLinux 10
SAMBA_BASE_PATH=/samba/mahasiswa

# Path direktori dan nama share operasional lab
SAMBA_OPERASIONAL_PATH=/samba/operasional
SAMBA_OPERASIONAL_SHARE=operasional

# Path script automation bash di server
SAMBA_SCRIPT_PATH=/usr/local/bin/buat_akun_samba.sh

# IP Server Samba LAN untuk petunjuk mahasiswa
SAMBA_SERVER_HOST=192.168.1.100
SAMBA_SHARE_NAME=mahasiswa

# Mode Simulasi (Set TRUE jika menguji coba di Mac/Windows/XAMPP lokal tanpa root Linux)
SAMBA_MOCK_SHELL=false

# ------------------------------------------------------------------------------
# DEFAULT CREDENTIALS (GANTI DI PRODUCTION!)
# ------------------------------------------------------------------------------
# Password awal akun admin & laboran saat inisialisasi pertama kali
ADMIN_DEFAULT_PASS=makisamba2026
LABORAN_DEFAULT_PASS=laboran123
